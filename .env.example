# Ambiente
NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=3000
API_HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://docops:docops_dev_password@localhost:5432/docops_agent
POSTGRES_USER=docops
POSTGRES_PASSWORD=docops_dev_password
POSTGRES_DB=docops_agent

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=troque_este_segredo_em_producao_use_openssl_rand_hex_32
JWT_EXPIRES_IN=8h

# LLM Provider
OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Observabilidade
OTEL_SERVICE_NAME=docops-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Upload
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads